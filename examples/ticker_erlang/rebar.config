%% A rebar3 project that uses the Elixir library from Erlang.
%%
%% rebar_mix lets rebar3 drive an Elixir dependency, so the published package is
%% fetched from Hex and compiled with mix, while this project stays plain Erlang.
{plugins, [rebar_mix]}.

{deps, [{gen_server_virtual_time, "1.0.1"}]}.

{profiles, [{test, [{erl_opts, [debug_info]}]}]}.
